# Settings for docker compose (copy to .env, which git ignores). Logins and passwords are NOT
# here: they are files under ./secrets (docker/make-secrets.sh).

# --- Bandzone (Selenium; off unless true) ---
BZSCRAPER_BANDZONE_SELENIUM_ENABLED=false
BZSCRAPER_BANDZONE_BANDSLUG=

# --- Bandsintown (Selenium; off unless true) ---
BZSCRAPER_BANDSINTOWN_SELENIUM_ENABLED=false
BZSCRAPER_BANDSINTOWN_ARTISTNAME=
# BZSCRAPER_BANDSINTOWN_ARTISTID=
# BZSCRAPER_BANDSINTOWN_NOTIFYFOLLOWERS=false

# --- Sign-in (the password is secrets/app_password) ---
# BZSCRAPER_AUTH_USERNAME=admin

# --- Online (docker compose --profile proxy up -d): the address the app is reached at; its DNS
#     must point to this server, ports 80 and 443 open. Caddy gets the certificate itself. ---
# BZ_DOMAIN=gigs.example.com

# --- This machine ---
# BZ_APP_BIND=127.0.0.1        # the app's port 8080: this machine only; 0.0.0.0 = the local network too
# BZ_SUBNET=10.201.0.0/24      # the containers' network (pick one no VPN route uses)
# BZ_DNS=1.1.1.1               # the app's name server for the internet (platforms, calendar, towns)
# BZ_UID=1000                  # the user owning ./data and ./secrets (id -u / id -g)
# BZ_GID=1000

# --- One-time move from the H2 database: its SQL backup, copied into an EMPTY database on
#     start (the path inside the container; ./data is /app/data). Remove after the move. ---
# BZSCRAPER_DB_IMPORTH2=/app/data/backups/bzscraper-h2-final.sql
