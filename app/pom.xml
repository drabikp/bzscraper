<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>sk.drabik</groupId>
		<artifactId>bzscraper</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>bzscraper-app</artifactId>
	<name>bzscraper-app</name>
	<description>The runnable application: wiring, configuration, the Vaadin theme.</description>
	<dependencies>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>bzscraper-application</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>bzscraper-adapter-persistence</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>bzscraper-adapter-bandzone</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>bzscraper-adapter-bandsintown</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>bzscraper-adapter-calendar</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>bzscraper-adapter-places</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>bzscraper-adapter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>bzscraper-adapter-rest</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>bzscraper-adapter-sync-worker</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>com.vaadin</groupId>
			<artifactId>vaadin-dev</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>bzscraper-domain</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<properties>
		<spring-boot.run.skip>false</spring-boot.run.skip>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- ./data, ./calendar etc. are relative to the repository root, not this module -->
					<workingDirectory>${project.basedir}/..</workingDirectory>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>production</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.vaadin</groupId>
						<artifactId>vaadin-maven-plugin</artifactId>
						<version>${vaadin.version}</version>
						<executions>
							<execution>
								<id>frontend</id>
								<phase>compile</phase>
								<goals>
									<goal>prepare-frontend</goal>
									<goal>build-frontend</goal>
								</goals>
								<configuration>
									<productionMode>true</productionMode>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
