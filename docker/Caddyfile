# The way in from the internet (compose profile "proxy"): HTTPS for BZ_DOMAIN with a Let's
# Encrypt certificate Caddy gets and renews itself (the domain's DNS must point here, ports 80
# and 443 open), HTTP redirected to HTTPS, everything passed to the app. BZ_DOMAIN=localhost
# tries it locally with Caddy's own certificate.
{$BZ_DOMAIN} {
	# the live updates (server-sent events) are a stream: never compressed or held back
	@notLive not path /api/events
	encode @notLive zstd gzip

	reverse_proxy app:8080 {
		flush_interval -1
	}

	header {
		-Server
		# browsers remember to come only over HTTPS (a year)
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
	}
}
