<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>sk.drabik</groupId>
	<artifactId>bzscraper</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>bzscraper</name>
	<description>Gig sync hub: one band's gig catalog, kept in sync with listing platforms.</description>

	<!-- Hexagonal: the domain and the application (use cases + ports) know no framework; every
	     adapter is its own module and depends only on the application; app wires them together. -->
	<modules>
		<module>domain</module>
		<module>application</module>
		<module>adapters/persistence</module>
		<module>adapters/browser</module>
		<module>adapters/bandzone</module>
		<module>adapters/bandsintown</module>
		<module>adapters/calendar</module>
		<module>adapters/places</module>
		<module>adapters/web</module>
		<module>adapters/rest</module>
		<module>adapters/sync-worker</module>
		<module>app</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<vaadin.version>25.0.5</vaadin.version>
		<!-- Pinned on purpose: H2's file format changes between versions, so a Spring Boot
		     upgrade must not silently bump it. To upgrade, restore a SCRIPT backup
		     (data/backups) into a fresh database with the new version. -->
		<h2.version>2.4.240</h2.version>
		<!-- only the app module runs (spring-boot:run) -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.vaadin</groupId>
				<artifactId>vaadin-bom</artifactId>
				<version>${vaadin.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-domain</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-application</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-application</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-adapter-persistence</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-adapter-browser</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-adapter-browser</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-adapter-bandzone</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-adapter-bandsintown</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-adapter-calendar</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-adapter-places</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-adapter-web</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-adapter-rest</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-adapter-sync-worker</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>1.22.1</version>
			</dependency>
			<dependency>
				<groupId>com.opencsv</groupId>
				<artifactId>opencsv</artifactId>
				<version>5.12.0</version>
			</dependency>
			<dependency>
				<groupId>org.seleniumhq.selenium</groupId>
				<artifactId>selenium-java</artifactId>
				<version>4.27.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
