<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>sk.drabik</groupId>
	<artifactId>bzscraper</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>bzscraper</name>
	<description>Gig sync hub: one band's gig catalog, kept in sync with listing platforms.</description>

	<!-- Vertical slices: one module per feature (features/), each with its own domain, application
	     (use cases + ports) and adapters; gig is the shared kernel. Platforms plug into the features'
	     ports (platforms/); app wires everything and runs. -->
	<modules>
		<module>features/gig</module>
		<module>features/places</module>
		<module>features/sync</module>
		<module>features/catalog</module>
		<module>features/importing</module>
		<module>features/check</module>
		<module>features/calendar</module>
		<module>platforms/browser</module>
		<module>platforms/bandzone</module>
		<module>platforms/bandsintown</module>
		<module>web/live</module>
		<module>web/frontend</module>
		<module>app</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<!-- Pinned on purpose: H2's file format changes between versions, so a Spring Boot
		     upgrade must not silently bump it. To upgrade, restore a SCRIPT backup
		     (data/backups) into a fresh database with the new version. -->
		<h2.version>2.4.240</h2.version>
		<!-- only the app module runs (spring-boot:run) -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-gig</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-gig</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-live</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-frontend</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-places</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-sync</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-sync</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-catalog</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-catalog</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-importing</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-check</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-calendar</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-browser</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-browser</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-bandzone</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-bandsintown</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>1.4.2</version>
			</dependency>
			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>1.22.1</version>
			</dependency>
			<dependency>
				<groupId>com.opencsv</groupId>
				<artifactId>opencsv</artifactId>
				<version>5.12.0</version>
			</dependency>
			<dependency>
				<groupId>org.seleniumhq.selenium</groupId>
				<artifactId>selenium-java</artifactId>
				<version>4.27.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
